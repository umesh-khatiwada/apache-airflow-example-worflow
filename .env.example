# Copy this file to `.env` (cp .env.example .env) before running `docker compose up`.
# docker-compose.yaml reads every value below.

# The Linux/macOS user id that owns files written by Airflow (logs etc.).
# On Linux run:  echo "AIRFLOW_UID=$(id -u)" >> .env
AIRFLOW_UID=50000

# Airflow image version used by every container.
AIRFLOW_IMAGE_NAME=apache/airflow:3.4.0

# Login for the Airflow UI at http://localhost:8080
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Fernet key encrypts passwords stored in connections/variables.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leaving it empty works for local learning but stores secrets unencrypted.
FERNET_KEY=

# Secret used to sign the JWT tokens between Airflow components. Change it for anything non-local.
AIRFLOW__API_AUTH__JWT_SECRET=change-me-local-dev-only
